        <mxCell id="KFWTrFei0LxFaC3EjcSE-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Todas preservam a adjacência&lt;/font&gt;" vertex="1">
