        <mxCell id="KFWTrFei0LxFaC3EjcSE-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Conclusão: os grafos são isomorfos?&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Sim, os grafos G e H são isomorfos, pois possuem a mesma quantidade de vértices e arestas e existe uma correspondência entre seus vértices que preserva todas as adjacências.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="362.5" x="10" y="840" as="geometry" />
        </mxCell>
        <mxCell id="KFWTrFei0LxFaC3EjcSE-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Reflexão: ter a mesma sequência de graus é suficiente para garantir isomorfismo?&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;-Não. A mesma sequência de graus não garante, sozinha, que dois grafos sejam isomorfos. É necessário verificar também como os vértices estão conectados entre si.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="350" x="10" y="1020" as="geometry" />
