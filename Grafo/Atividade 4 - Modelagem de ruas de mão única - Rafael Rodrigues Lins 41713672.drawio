        <mxCell id="eC9dH8ZyD7G253RybXqz-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Vértices: V = {A, B, C, D}&lt;/font&gt;" vertex="1">
