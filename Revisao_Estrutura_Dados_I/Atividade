#include <stdio.h>

int main() {

  int i;

  float nota;

  char genero;

  int aprovados = 0, recuperacao = 0;

  int feminino = 0, masculino = 0, outro = 0;


  for (i = 1; i <= 30; i++) {

    printf("\n--- Estudante %d ---\n", i);

     

    printf("Gênero (F - Feminino / M - Masculino / O - Outro): ");

    scanf(" %c", &genero);

     

    if (genero == 'F' || genero == 'f') {

      feminino = feminino + 1;

    } else if (genero == 'M' || genero == 'm') {

      masculino = masculino + 1;

    } else {

      outro = outro + 1;

    }


    printf("Nota final de Português (0 a 10): ");

    scanf("%f", &nota);

     

    // Verificação da situação

    if (nota >= 7.0) {

      aprovados = aprovados + 1;

    } else if (nota >= 5.0 && nota < 7.0) {

      recuperacao = recuperacao + 1;

    }

  }


  printf("\n========== RESULTADO FINAL ==========\n");

  printf("Estudantes aprovados (nota >= 7): %d\n", aprovados);

  printf("Estudantes em recuperação (5 <= nota < 7): %d\n", recuperacao);

  printf("Estudantes do gênero Feminino: %d\n", feminino);

  printf("Estudantes do gênero Masculino: %d\n", masculino);

  printf("Estudantes de outro gênero: %d\n", outro);

   

  return 0;

}



   return 0;

}
