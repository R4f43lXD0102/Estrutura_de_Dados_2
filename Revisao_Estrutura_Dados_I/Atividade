#include <stdio.h>
#include <string.h>

int main() {
    char *animais[] = {"cavalo", "bode", "gato", "cachorro", "cabra"};
    char animal_digitado[20]; // Assuming a max length of 19 characters + null terminator

    printf("Digite em letra minuscula o nome de um animal: ");
    scanf("%19s", animal_digitado); // Read input (max 19 chars to prevent buffer overflow)

    int encontrado = 0; // Flag to check if the animal is found

    // Loop through the array and compare strings
    for (int i = 0; i < 5; i++) {
        if (strcmp(animal_digitado, animais[i]) == 0) {
            encontrado = 1;
            break;
        }
    }

    if (encontrado) {
        printf("Este animal faz parte da minha lista\n");
    } else {
        printf("Este animal nao faz parte da minha lista\n");
    }

    return 0;
}
